# Enhanced Weekly Performance Reporter Configuration
# Copy this file to .env and fill in your credentials

# Email Configuration (existing)
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
RECIPIENT_EMAIL=you@example.com

# Alpaca Trading API Configuration
# Get these from your Alpaca dashboard: https://app.alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Use paper trading by default

# For live trading (USE WITH CAUTION):
# ALPACA_BASE_URL=https://api.alpaca.markets

# Financial Market Prep API (optional, for enhanced macro data)
FMP_API_KEY=your_fmp_api_key_here

# Portfolio Configuration
DEFAULT_PORTFOLIO_SIZE=50000  # Default portfolio size for calculations
BENCHMARK_SYMBOL=SPY  # Benchmark for comparison

# Report Configuration
REPORT_TIMEZONE=US/Eastern
INCLUDE_WATCHLIST=true
WATCHLIST_CANDIDATES_COUNT=10
INCLUDE_FUNDAMENTALS=true
INCLUDE_SECTOR_ANALYSIS=true

# Risk Analysis Settings
VAR_CONFIDENCE_LEVEL=0.95
VOLATILITY_LOOKBACK_DAYS=252

# Chart Settings
CHART_STYLE=seaborn-v0_8
CHART_DPI=300
CHART_FIGSIZE_WIDTH=12
CHART_FIGSIZE_HEIGHT=8

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/weekly_reports.log 